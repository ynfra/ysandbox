# Public URL of the Helicone instance
SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Jawn proxy service URL
NEXT_PUBLIC_HELICONE_JAWN_SERVICE=http://localhost:8585

# MinIO S3 endpoint (exposed at port 9081 externally)
S3_ENDPOINT=http://localhost:9081
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=request-response-storage

# Auth secret — CHANGE IN PRODUCTION
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=changeme-generate-with-openssl-rand-hex-32

# Self-hosted flag
NEXT_PUBLIC_IS_ON_PREM=true
