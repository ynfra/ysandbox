# langflow-mcp-server configuration (sandbox-safe placeholders)

# Base URL of your running Langflow instance (no /api/v1 suffix).
# From inside the container, host.docker.internal points at the Docker host,
# so a Langflow running on the host at :7860 is reachable here.
# Point this at the ysandbox `langflow` stack when running both together.
LANGFLOW_BASE_URL=http://host.docker.internal:7860

# Langflow API key — grab it from your Langflow instance settings.
# Placeholder only; the bridge starts and binds the port without a valid key,
# but real tool calls need a reachable Langflow + valid key.
LANGFLOW_API_KEY=changeme-sandbox-key

# Consolidate the granular Langflow tools into fewer action-based meta-tools
# (true/false). Pinned server v3.1.1 groups ~93 tools into ~15 when enabled.
LANGFLOW_CONSOLIDATED_TOOLS=true

# Log level: debug, info, warn, error
LOG_LEVEL=info
