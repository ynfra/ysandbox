# PostgreSQL — sandbox-safe defaults, change for production
POSTGRES_USER=langflow
POSTGRES_PASSWORD=langflow
POSTGRES_DB=langflow

# Langflow
# Points at the postgres service above.
LANGFLOW_DATABASE_URL=postgresql://langflow:langflow@postgres:5432/langflow
# Where logs, file storage, monitor data and secret keys are stored (inside the container).
LANGFLOW_CONFIG_DIR=/app/langflow

# Optional: pre-create an admin login (requires LANGFLOW_AUTO_LOGIN=false)
# LANGFLOW_AUTO_LOGIN=false
# LANGFLOW_SUPERUSER=admin
# LANGFLOW_SUPERUSER_PASSWORD=admin123
# LANGFLOW_SECRET_KEY=change-me-openssl-rand-hex-32
