{
  "name": "celld-apps",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "APPS_DOMAINS": "apps.localhost,apps.nomad.orb.local",
    "AUTH_MODE": "none",
    "PUBLIC_PORT": "8080"
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "APP", "class_name": "AppHost" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry", "AppHost"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "files" }]
}
