{
  "tool": "codegraphcontext",
  "profile": "codegraphcontext",
  "llm_at_index": false,
  "serve": "docker compose --profile codegraphcontext up -d --wait codegraphcontext",
  "index": {
    "mode": "oneshot",
    "cmd": "docker compose --profile codegraphcontext run --rm codegraphcontext-index /repos/{repo}",
    "ready": null,
    "timeout_s": 7200
  },
  "mcp": { "url": "http://localhost:4360/mcp", "headers": {} },
  "search": { "tool": "find_code", "args": { "query": "{query}" } },
  "containers": ["codebase-lab-codegraphcontext-1", "codebase-lab-codegraphcontext-db-1"],
  "disk": [".docker/codegraphcontext"],
  "stop": "docker compose stop codegraphcontext codegraphcontext-db codegraphcontext-watch"
}
