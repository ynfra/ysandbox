# Copy to .env (gitignored). Every value has a working default; .env is only
# needed to change one.

# Where the models run. Default is the CPU-only ollama container in this lab.
# Faster: Ollama on the Mac (Metal GPU):
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434

# Behind the LiteLLM names `chat` and `embed`. Small defaults so CPU works;
# on the Mac try qwen2.5-coder:14b or qwen3-coder:30b.
CHAT_MODEL=qwen2.5-coder:3b
EMBED_MODEL=nomic-embed-text

# Master key for LiteLLM (4320); tools send it as their OpenAI API key.
LAB_KEY=sk-codebase-lab

# Seconds between git-sync polls. Webhooks make pushes near-instant anyway.
SYNC_INTERVAL=60
