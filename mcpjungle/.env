# MCPJungle server
# development mode = single-user local setup, no auth (use `enterprise` for teams)
SERVER_MODE=development
OTEL_ENABLED=false
MCP_SERVER_INIT_REQ_TIMEOUT_SEC=10

# Host port for the MCP gateway (streamable HTTP at http://localhost:8080/mcp)
HOST_PORT=8080

# Image tag — `latest-stdio` bundles npx/uvx for stdio-based MCP servers.
# Use `latest` for the minimal image (remote/streamable-http servers only).
MCPJUNGLE_IMAGE_TAG=latest-stdio

# PostgreSQL — sandbox-safe defaults, change for any real deployment
POSTGRES_USER=mcpjungle
POSTGRES_PASSWORD=mcpjungle
POSTGRES_DB=mcpjungle
