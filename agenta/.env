# Agenta — CHANGE THESE KEYS IN PRODUCTION
# Generate with: openssl rand -hex 32
AGENTA_AUTH_KEY=changeme-auth-key-32-chars-minimum
AGENTA_CRYPT_KEY=changeme-crypt-key-32-chars-min

# PostgreSQL
POSTGRES_USER=agenta
POSTGRES_PASSWORD=agenta

# Image tags (pin to a specific version for stability)
AGENTA_WEB_IMAGE_TAG=latest
AGENTA_API_IMAGE_TAG=latest
AGENTA_SERVICES_IMAGE_TAG=latest

# External port for the Traefik UI proxy (default: 8081)
AGENTA_PORT=8081
