# Supabase Self-Hosted Configuration
# Key generation: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys

############
# Secrets
############

# Database password
POSTGRES_PASSWORD=supabase-sandbox

# JWT secret (min 32 characters)
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# JWT keys (generate with the tool at the URL above after setting JWT_SECRET)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Dashboard login
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase

# Phoenix/Erlang secret (min 64 chars)
SECRET_KEY_BASE=sandbox-secret-key-base-min-64-chars-long-enough-for-phoenix-erlang!

# Supavisor encryption key (exactly 32 chars)
VAULT_ENC_KEY=sandbox-vault-enc-key-32chars-ok

# pg-meta encryption key (min 32 chars)
PG_META_CRYPTO_KEY=sandbox-crypto-key-min-32-chars!

# Analytics log tokens
LOGFLARE_PUBLIC_ACCESS_TOKEN=sandbox-logflare-token
LOGFLARE_PRIVATE_ACCESS_TOKEN=sandbox-logflare-private

# S3 protocol credentials
S3_PROTOCOL_ACCESS_KEY_ID=sandbox-s3-key
S3_PROTOCOL_ACCESS_KEY_SECRET=sandbox-s3-secret

############
# URLs
############

SUPABASE_PUBLIC_URL=http://localhost:8000
