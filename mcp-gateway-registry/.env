# ---------------------------------------------------------------------------
# MCP Gateway & Registry — sandbox environment.
# SANDBOX-SAFE DEFAULTS ONLY. Generate real secrets before any real use:
#   openssl rand -hex 32   # SECRET_KEY (>=32 chars)
# ---------------------------------------------------------------------------

# --- Pre-built image source (Amazon ECR Public) ---------------------------
ECR_REGISTRY=public.ecr.aws/p3v1o3c6
REGISTRY_VERSION=latest
AUTH_SERVER_VERSION=latest
MCPGW_VERSION=latest

# --- Core application secret (required, >=32 chars) -----------------------
SECRET_KEY=sandbox-mcp-gateway-secret-key-change-me-000000
# Shared nginx->auth-server marker secret (required, >=32 chars, identical
# in registry + auth-server). Prevents forged direct :8888 /validate calls.
AUTH_SERVER_NGINX_MARKER_SECRET=sandbox-nginx-marker-secret-change-me-00000000

# --- External URLs --------------------------------------------------------
REGISTRY_URL=http://localhost:7860
AUTH_SERVER_URL=http://auth-server:8888
AUTH_SERVER_EXTERNAL_URL=http://localhost:8888

# --- Registry identity ----------------------------------------------------
REGISTRY_NAME=AI Registry
REGISTRY_ORGANIZATION_NAME=ACME Inc.
DEPLOYMENT_MODE=with-gateway
REGISTRY_MODE=full

# --- MongoDB (storage backend) --------------------------------------------
DOCUMENTDB_USERNAME=admin
DOCUMENTDB_PASSWORD=sandbox-mongo-pass
DOCUMENTDB_DATABASE=mcp_registry
STORAGE_BACKEND=mongodb-ce

# --- OpenBao (egress credential vault, dev mode) --------------------------
OPENBAO_TOKEN=dev-root-token

# --- Identity provider: Keycloak (local dev default) ----------------------
AUTH_PROVIDER=keycloak
KEYCLOAK_ENABLED=true
KEYCLOAK_REALM=mcp-gateway
KEYCLOAK_CLIENT_ID=mcp-gateway-web
KEYCLOAK_CLIENT_SECRET=sandbox-keycloak-client-secret
KEYCLOAK_M2M_CLIENT_ID=mcp-gateway-m2m
KEYCLOAK_M2M_CLIENT_SECRET=sandbox-keycloak-m2m-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=sandbox-keycloak-admin
KEYCLOAK_DB_PASSWORD=sandbox-keycloak-db

# --- Metrics API keys (internal service-to-service) -----------------------
METRICS_API_KEY_REGISTRY=sandbox-metrics-registry
METRICS_API_KEY_AUTH_SERVER=sandbox-metrics-auth

# --- Grafana (metrics dashboards) -----------------------------------------
GRAFANA_ADMIN_PASSWORD=sandbox-grafana-admin

# --- Misc -----------------------------------------------------------------
# Disable anonymous usage telemetry in the sandbox.
MCP_TELEMETRY_DISABLED=1
# Bind loopback-only service ports to this host IP (0.0.0.0 to expose).
HOST_BIND_IP=127.0.0.1
