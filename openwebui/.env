# Open WebUI Configuration
# See: https://docs.openwebui.com/getting-started/env-configuration

# Security
WEBUI_SECRET_KEY=81bfcff2bfcc776fca8660eb1962f8d1c42b36b68040a4b49333a8d535c9b9f0

# Authentication
WEBUI_AUTH=true

# Disable Ollama (using external providers only)
ENABLE_OLLAMA_API=false

# OpenAI-compatible providers (uncomment to enable)
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# Multiple endpoints (semicolon-separated)
# OPENAI_API_BASE_URLS=https://api.openai.com/v1;https://openrouter.ai/api/v1
# OPENAI_API_KEYS=sk-openai-key;sk-openrouter-key

# Telemetry
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
